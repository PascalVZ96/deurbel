# Serienummer van de Eufy deurbel. Zet je eigen serienummer alleen in .env.
EUFY_SERIAL=T8213XXXXXXXXXXXX

# Serienummer van de gekoppelde HomeBase.
EUFY_STATION_SERIAL=T8030XXXXXXXXXXXX

# eufy-security-ws draait op dezelfde Ubuntu-server.
EUFY_WS_URL=ws://127.0.0.1:3000

# Dashboard en interne viewer.
WEB_PORT=8090
VIEWER_PORT=8092

# Livebeeld.
MJPEG_FPS=8
MJPEG_QUALITY=5
WATCHDOG_SECONDS=8

# Zuinige beveiliging:
# Automatische Eufy-beweging haalt de originele HomeBase-opname op zonder
# de livestream te starten. POST /api/trigger blijft beschikbaar voor een
# toekomstige losse PIR-sensor of handmatige test.
EVENT_RECORD_SECONDS=30
EVENT_WAKE_TIMEOUT_SECONDS=15
MAX_RECORD_SECONDS=120

# HomeBase self-healing.
# Normale controle elke 5 seconden. Na 3 opeenvolgende fouten wordt de
# WebSocket automatisch opnieuw opgebouwd; daarna blijft hij elke 3 seconden
# opnieuw proberen zolang eufy-security-ws nog niet gereed is.
HOMEBASE_POLL_MS=5000
HOMEBASE_RECOVER_AFTER_FAILURES=3
HOMEBASE_RECONNECT_MS=3000

# Slimme deurbel-accumonitor.
# Leest de Eufy device-properties zonder een livestream te starten. De actuele
# waarde en maximaal 30 dagen geschiedenis worden lokaal in ./data bewaard.
BATTERY_POLL_MS=900000
BATTERY_LOW_PERCENT=20
BATTERY_CRITICAL_PERCENT=10

# Als een intern Node-proces onverwacht stopt, start de launcher alleen dat
# onderdeel opnieuw zonder de hele container of camera onnodig te herstarten.
PROCESS_RESTART_DELAY_SECONDS=3

# Opnames.
RETENTION_DAYS=14
# De productie-compose bind-mount /mnt/security/deurbel naar /recordings en
# weigert de containerstart als die hostmap niet bestaat.
