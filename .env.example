# Serienummer van de Eufy deurbel. Zet je eigen serienummer alleen in .env.
EUFY_SERIAL=T8213XXXXXXXXXXXX

# eufy-security-ws draait op dezelfde Ubuntu-server.
EUFY_WS_URL=ws://127.0.0.1:3000

# Dashboard en interne viewer.
WEB_PORT=8090
VIEWER_PORT=8092

# Livebeeld.
MJPEG_FPS=8
MJPEG_QUALITY=5
WATCHDOG_SECONDS=8

# Eigen bewegingsdetectie. Lager percentage = gevoeliger.
MOTION_FPS=2
MOTION_PIXEL_THRESHOLD=24
MOTION_THRESHOLD_PERCENT=1.5
MOTION_MIN_HITS=2
MOTION_WARMUP_SECONDS=3

# Opnames: 5 seconden vóór beweging en 15 seconden erna.
PRE_RECORD_SECONDS=5
POST_RECORD_SECONDS=15
MAX_RECORD_SECONDS=300
RETENTION_DAYS=14

# Nu lokaal in ./recordings. Later kan dit bijvoorbeeld /mnt/security worden.
RECORDINGS_HOST_PATH=./recordings
